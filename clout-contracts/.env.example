# Copy to .env and fill in. Never commit the real .env or anything in keys/.
# Testnet deployer. Use a dedicated wallet, never your main one.
CLOUT_DEPLOYER_KEY=
CLOUT_DEPLOYER_ADDRESS=

# Mainnet, only when deploying the audited contracts. Keep separate from the testnet key.
CLOUT_MAINNET_DEPLOYER_KEY=
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
