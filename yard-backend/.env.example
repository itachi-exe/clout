# Copy to .env and fill in. Never commit the real .env.
PORT=7080

# Long random string used to sign login sessions. Generate: openssl rand -hex 32
ARCYARD_JWT_SECRET=

# Arc RPC the indexers read from
ARC_RPC_URL=https://rpc.testnet.arc.io

# Deployed contract addresses and the block they were deployed at (see yard-contracts/deployments/)
ARCYARD_CONTRACT_ADDRESS=
ARCYARD_DEPLOY_BLOCK=
ARCYARD_KEYS_CONTRACT_ADDRESS=
ARCYARD_KEYS_DEPLOY_BLOCK=
