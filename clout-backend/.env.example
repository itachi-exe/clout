# Copy to .env and fill in. Never commit the real .env.
PORT=7080

# Long random string used to sign login sessions. Generate: openssl rand -hex 32
CLOUT_JWT_SECRET=

# Arc RPC the indexers read from
ARC_RPC_URL=https://rpc.testnet.arc.io

# Deployed contract addresses and the block they were deployed at (see clout-contracts/deployments/)
CLOUT_CONTRACT_ADDRESS=
CLOUT_DEPLOY_BLOCK=
CLOUT_KEYS_CONTRACT_ADDRESS=
CLOUT_KEYS_DEPLOY_BLOCK=
